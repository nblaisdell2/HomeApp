{
  "openapi": "3.0.3",
  "info": {
    "title": "Home API",
    "description": "Backend for the Home app (phone + wall tablet).",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-device API key issued with `npm run issue-key`"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "statusCode",
          "error",
          "message"
        ],
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": [
          "status",
          "database",
          "time"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "connected",
              "unreachable"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeviceHealthStatus": {
        "type": "object",
        "required": [
          "status",
          "device",
          "time"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "device": {
            "type": "string",
            "description": "Name of the device the API key was issued to"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ShoppingItem": {
        "type": "object",
        "required": [
          "id",
          "name",
          "modifiedAt",
          "deleted",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Client-generated UUID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "store": {
            "type": "string",
            "maxLength": 100
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the item was last edited on a device; used for last-write-wins"
          },
          "deleted": {
            "type": "boolean",
            "description": "Tombstone: true once the item has been removed"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Server change sequence number; increases on every accepted write"
          }
        }
      },
      "ShoppingItemUpsert": {
        "type": "object",
        "required": [
          "name",
          "modifiedAt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "store": {
            "type": "string",
            "maxLength": 100
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ShoppingItemUpsertResult": {
        "type": "object",
        "required": [
          "applied",
          "item"
        ],
        "properties": {
          "applied": {
            "type": "boolean",
            "description": "False when the server already had a newer edit; item is then the winning version"
          },
          "item": {
            "$ref": "#/components/schemas/ShoppingItem"
          }
        }
      },
      "ShoppingItemChanges": {
        "type": "object",
        "required": [
          "items",
          "cursor",
          "hasMore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShoppingItem"
            }
          },
          "cursor": {
            "type": "integer",
            "format": "int64",
            "description": "Pass as `since` on the next call to get only newer changes"
          },
          "hasMore": {
            "type": "boolean",
            "description": "True when more changes are available past cursor"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service and database status (no auth)",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "getAuthenticatedHealth",
        "summary": "Confirms the caller has a valid device API key",
        "tags": [
          "health"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceHealthStatus"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shopping-items": {
      "get": {
        "operationId": "listShoppingItemChanges",
        "summary": "Items changed since a cursor (use since=0 for everything)",
        "tags": [
          "shopping"
        ],
        "description": "Returns items, including deleted tombstones, whose version is greater than `since`. Keep calling with the returned cursor while hasMore is true.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "default": 0
            },
            "in": "query",
            "name": "since",
            "required": true
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 500
            },
            "in": "query",
            "name": "limit",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShoppingItemChanges"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shopping-items/{id}": {
      "put": {
        "operationId": "upsertShoppingItem",
        "summary": "Create, update or delete (deleted=true) an item; last write wins",
        "tags": [
          "shopping"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShoppingItemUpsert"
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShoppingItemUpsertResult"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "streamEvents",
        "summary": "Server-Sent Events stream of data changes",
        "tags": [
          "events"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream with `ready` and `change` events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Service status"
    },
    {
      "name": "shopping",
      "description": "Shopping list items"
    },
    {
      "name": "events",
      "description": "Live change notifications"
    }
  ]
}
